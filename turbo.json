{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "2",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CI", "GIA_DATABASE_URL_TESTE", "GIA_AD_TESTE_*"]
    }
  }
}
